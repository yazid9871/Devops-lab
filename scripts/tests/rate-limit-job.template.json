{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {"name": "__TEST_NAME__", "namespace": "demo", "labels": {"lab-role": "rate-limit-test"}},
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 300,
    "ttlSecondsAfterFinished": 600,
    "template": {
      "metadata": {"labels": {"lab-role": "rate-limit-test"}},
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "securityContext": {"runAsNonRoot": true, "runAsUser": 10001, "runAsGroup": 10001, "seccompProfile": {"type": "RuntimeDefault"}},
        "containers": [{
          "name": "client",
          "image": "python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641",
          "command": ["python", "-B", "-u", "/tests/client.py"],
          "env": [{"name": "CLIENT_IMAGE", "value": "python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641"}],
          "resources": {"requests": {"cpu": "100m", "memory": "64Mi"}, "limits": {"cpu": "1", "memory": "256Mi"}},
          "securityContext": {"readOnlyRootFilesystem": true, "allowPrivilegeEscalation": false, "capabilities": {"drop": ["ALL"]}},
          "volumeMounts": [{"name": "tests", "mountPath": "/tests", "readOnly": true}]
        }],
        "volumes": [{"name": "tests", "configMap": {"name": "__TEST_NAME__"}}]
      }
    }
  }
}
