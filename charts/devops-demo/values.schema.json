{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "resources", "ingress"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"const": "localhost:5001/devops-demo"},
        "tag": {"type": "string", "pattern": "^v[0-9]+$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "resources": {"type": "object"},
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "tls", "rateLimit"],
      "properties": {
        "enabled": {"const": true},
        "className": {"const": "traefik-lab"},
        "host": {"const": "localhost"},
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "average", "period", "burst"],
          "properties": {
            "enabled": {"type": "boolean"},
            "average": {"type": "integer", "minimum": 1, "maximum": 1000},
            "period": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
            "burst": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        },
        "tls": {
          "type": "object",
          "required": ["secretName", "issuerName", "duration", "renewBefore"],
          "properties": {
            "secretName": {"const": "devops-demo-tls"},
            "issuerName": {"const": "devops-lab-ca"},
            "duration": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
            "renewBefore": {"type": "string", "pattern": "^[1-9][0-9]*h$"}
          }
        }
      }
    }
  }
}
